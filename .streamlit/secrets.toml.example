# Copy these keys into Streamlit Community Cloud's app Secrets settings.
# Do not commit real credentials or share the API key.
# Groq is preferred when both provider keys are present. Its account owner must be 18+.
GROQ_API_KEY = "add-your-groq-key-in-hosting-secrets"
# Optional fallback; omit this if using the Groq free tier.
# OPENAI_API_KEY = "add-your-openai-key-in-hosting-secrets"
APP_PASSWORD = "set-a-private-demo-password"
